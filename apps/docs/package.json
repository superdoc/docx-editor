{
  "name": "@superdoc/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "check:links": "node scripts/check-links.mjs",
    "check:redirects": "node scripts/redirects.mjs check",
    "generate:config-reference": "pnpm exec tsx scripts/generate-config-reference.ts",
    "generate:reference": "pnpm generate:config-reference && pnpm exec tsx scripts/generate-document-api-reference.ts",
    "generate:redirects": "node scripts/redirects.mjs generate",
    "generate:routes": "node scripts/redirects.mjs routes",
    "generate:fixtures": "node scripts/build-getting-started-fixture.mjs && node scripts/build-quickstart-fixture.mjs && node scripts/build-demo-fixtures.mjs",
    "generate:migration-catalog": "tsx scripts/generate-migration-catalog.ts",
    "sync:runtime": "node scripts/sync-editor-demo-runtime.mjs",
    "check:runtime": "node scripts/sync-editor-demo-runtime.mjs --check",
    "dev": "pnpm sync:runtime && pnpm generate:migration-catalog && pnpm generate:reference && next dev --port 3002",
    "build": "pnpm sync:runtime && pnpm generate:migration-catalog && pnpm generate:reference && next build && pnpm generate:redirects && pnpm generate:v1-redirects",
    "test:migration-catalog": "pnpm sync:runtime && pnpm generate:reference && tsx --test tests/migration-catalog.test.mjs",
    "test:migration-explorer": "tsx --test tests/migration-explorer.test.mjs",
    "test:migration-explorer-contrast": "tsx --test tests/migration-explorer-contrast.test.mjs",
    "test:migration-agent-prompt": "node --test tests/migration-agent-prompt.test.mjs",
    "test:export": "pnpm sync:runtime && node --test tests/export.test.mjs",
    "test:fixtures": "node --test tests/fixtures.test.mjs",
    "test:links": "node --test tests/link-checker.test.mjs",
    "test:redirects": "node --test tests/redirects.test.mjs tests/deployed-redirects.test.mjs",
    "test:migration-snippets:contract": "node scripts/verify-migration-snippets.mjs && MIGRATION_SNIPPETS_CONTRACT_ONLY=1 node scripts/execute-migration-snippets.mjs",
    "typecheck": "pnpm sync:runtime && pnpm generate:reference && fumadocs-mdx && tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.headless-snippets.json",
    "test:version-menu": "node --test tests/version-menu.test.mjs",
    "generate:v1-redirects": "node scripts/v1-routes.mjs generate",
    "verify:v1-routes": "node scripts/verify-route-matrix.mjs",
    "verify:not-found": "node scripts/verify-not-found.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "catalog:",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-typescript": "catalog:",
    "fumadocs-ui": "catalog:",
    "lucide-react": "^1.25.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@superdoc/react": "workspace:*",
    "@superdoc/document-api": "workspace:*",
    "@superdoc/sdk": "2.11.0-next.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jszip": "catalog:",
    "parse5": "8.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:"
  }
}
