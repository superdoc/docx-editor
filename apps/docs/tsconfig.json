{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@superdoc/react": ["../../packages/react/src/index.ts"],
      "collections/*": ["./.source/*"],
      "superdoc": ["../../packages/superdoc/src/public/index.ts"],
      "superdoc/ui": ["../../packages/superdoc/src/public/ui.ts"],
      "superdoc/ui/react": ["../../packages/superdoc/src/public/ui-react.ts"],
      "@superdoc/document-api": ["../../packages/document-api/src/index.ts"],
      "@superdoc/layout-bridge": ["../../packages/layout-engine/layout-bridge/src/index.ts"]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "../../packages/superdoc/src/vite-env.d.ts",
    "../../packages/superdoc/src/shims-vue.d.ts",
    "../../packages/layout-engine/layout-bridge/src/bidi-js.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".source/**/*.ts"
  ],
  "exclude": ["node_modules", "scripts", "collaboration-server", "snippets/headless"]
}
