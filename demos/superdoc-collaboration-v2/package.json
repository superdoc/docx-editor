{
  "name": "superdoc-collaboration-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "concurrently -k -n CLIENT,SERVER -c cyan,green \"pnpm run dev:client\" \"pnpm run dev:server\"",
    "dev:client": "vite --port 3100 --strictPort",
    "dev:server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^8.2.0",
    "@hocuspocus/server": "2.15.3",
    "concurrently": "9.2.1",
    "fastify": "^5.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "superdoc": "2.9.0",
    "tsx": "4.22.4",
    "ws": "8.18.3",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@types/node": "22.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  }
}
