{
  "name": "@superdoc-examples/collaboration",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "concurrently -k \"tsx server.ts\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "playwright test",
    "test:persistence": "playwright test --config playwright.persistence.config.ts",
    "test:storage": "tsx --test local-storage.test.ts",
    "test:access": "playwright test --config playwright.access.config.ts",
    "browsers": "playwright install chromium",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hocuspocus/server": "2.15.3",
    "superdoc": "2.11.0",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.2",
    "jszip": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.2.7"
  }
}
