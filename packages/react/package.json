{
  "name": "@superdoc/react",
  "version": "2.9.0-next.8",
  "description": "Official React wrapper for the SuperDoc document editor",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "import": "./style.css",
      "require": "./style.css"
    }
  },
  "scripts": {
    "build": "vp build",
    "dev": "vp build --watch",
    "test": "vp test run",
    "pretype-check": "pnpm --prefix ../superdoc run build:es",
    "type-check": "tsc --noEmit",
    "lint": "pnpm -w exec vp lint packages/react/src",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "superdoc",
    "react",
    "document",
    "editor",
    "docx",
    "word"
  ],
  "license": "AGPL-3.0",
  "dependencies": {
    "superdoc": "workspace:2.14.0-next.8"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "superdoc": "workspace:2.14.0-next.8"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "style.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superdoc/docx-editor.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/superdoc/docx-editor/issues"
  },
  "homepage": "https://github.com/superdoc/docx-editor/tree/main/packages/react"
}
